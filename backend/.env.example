# Copy to backend/.env (git-ignored) and replace every <placeholder>. Never commit real values.
# Process environment variables take precedence over this file.

# One of: local, ci, production. No default.
ENVIRONMENT=local

# Each target reads only its own variable; none falls back to another (no default URLs).
# The role must be a NOSUPERUSER role: the guards refuse `postgres` and any superuser.
DATABASE_URL=postgresql+psycopg://imibereho:<password>@localhost:5432/imibereho
TEST_DATABASE_URL=postgresql+psycopg://imibereho:<password>@localhost:5432/imibereho_test
MIGRATIONS_DATABASE_URL=postgresql+psycopg://imibereho:<password>@localhost:5432/imibereho_migrations

# Comma-separated browser origins allowed by CORS. The deployed frontend origin is to be
# supplied by the frontend team.
CORS_ORIGINS=http://localhost:5173

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Largest accepted request body in bytes (1024 to 1048576; default 65536). Larger bodies get
# 413 `request-too-large` before they are parsed.
# MAX_REQUEST_BODY_BYTES=65536

# Local development only. When true, DATABASE_URL may use the `postgres` superuser, but ONLY for
# target `dev` with ENVIRONMENT=local on a local host (the local server, migrate/seed --target dev).
# TEST_DATABASE_URL and MIGRATIONS_DATABASE_URL must still use the NOSUPERUSER `imibereho` role,
# and any ENVIRONMENT other than `local` refuses to start if this is true. Recommended: false.
ALLOW_LOCAL_SUPERUSER=false

# Signs the bearer tokens of POST /api/v1/auth/register and /auth/login (HS256). At least 32
# characters; generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave it empty and those two endpoints answer 503 auth-not-configured; nothing else needs it.
JWT_SECRET_KEY=

# Optional, for the superuser-rejection integration tests only (never used by the app):
# SUPERUSER_POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/imibereho_test
# SUPERUSER_ALT_DATABASE_URL=postgresql+psycopg://<temporary superuser>:<password>@localhost:5432/imibereho_test
