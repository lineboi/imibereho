{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://bike-talking-requested-ascii.trycloudflare.com/api/:match*"
    },
    {
      "source": "/ready",
      "destination": "https://bike-talking-requested-ascii.trycloudflare.com/ready"
    },
    {
      "source": "/health",
      "destination": "https://bike-talking-requested-ascii.trycloudflare.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
